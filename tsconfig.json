{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "experiments/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "results"]
}
